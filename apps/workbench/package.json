{
  "name": "@circle/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared renderer for the Circle native desktop workbench",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4200 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4202 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node ../../node_modules/tsx/dist/cli.mjs --import ./test/helpers/ignore-css.mjs --test test/*.test.ts",
    "format:check": "prettier --check src test scripts package.json tsconfig.json vite.config.ts index.html",
    "test:ui": "npm --prefix ../desktop run test:interface",
    "test:editor": "node ../../node_modules/tsx/dist/cli.mjs test/editor-ui.mjs",
    "test:components": "node test/component-suites.mjs",
    "test:visual": "playwright test --config test/visual/playwright.config.mjs",
    "postinstall": "node scripts/prepare-monaco.mjs",
    "predev": "node scripts/prepare-monaco.mjs",
    "prebuild": "node scripts/prepare-monaco.mjs",
    "pretest": "node scripts/prepare-monaco.mjs",
    "pretest:components": "node scripts/prepare-monaco.mjs",
    "pretest:editor": "node scripts/prepare-monaco.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.55.0",
    "monaco-editor": "0.57.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.3",
    "react-router-dom": "7.18.4",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "fsevents": true
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
