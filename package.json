{
  "name": "circle",
  "version": "1.0.4",
  "private": true,
  "description": "A terminal coding agent for your own model endpoint",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "circle": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/prompts",
    "docs",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"*.json\"",
    "check": "npm run typecheck && npm test && npm run build",
    "port:status": "tsx scripts/port-status.ts",
    "release:build": "tsx scripts/build-release.ts",
    "release:smoke": "tsx scripts/smoke-release.ts",
    "release": "tsx scripts/release.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qingshanfeihu/circle.git"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/ws": "8.18.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@msgpack/msgpack": "3.1.3",
    "ajv": "8.20.0",
    "entities": "8.1.0",
    "glob": "13.0.6",
    "marked": "18.1.0",
    "openai": "7.30.1",
    "proper-lockfile": "4.1.2",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0"
  }
}
